# Chessplain v3 — copy to the engine's EnvironmentFile (VPS: /etc/chessplain/engine.env)
# and/or your local shell. Never commit real secrets.
# SUPABASE_URL and SUPABASE_ANON_KEY (engine) and NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY (web) are REQUIRED — the code has no fallback
# and will refuse to start without them.

# --- Engine (apps/engine) ---
PORT=8080
NODE_ENV=production
SUPABASE_URL=https://jgtxprfulkbtzkcvinph.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpndHhwcmZ1bGtidHprY3ZpbnBoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjEyODk0ODIsImV4cCI6MjA3Njg2NTQ4Mn0.E8eXXrpiAiA_T0wz5yh_u6m2USL7QMs7IfSDc80bIKI
LLM_API_BASE=https://crof.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_1SOs7yFtgmZSE6kx0wJ3wY3u
STRIPE_PRICE_YEARLY=price_1SOs7yFtgmZSE6kxI9RoSTXR
POSTHOG_KEY=phc_UKy5oAuRvZ0zofoUDe1hWPGchLU1IkcpjOP2P3aCUa5
POSTHOG_HOST=https://eu.i.posthog.com
ENGINE_PATH=/usr/local/bin/stockfish18_clang
SYZYGY_PATH=/var/chess/syzygy
WEB_ORIGIN=https://getchessplain.com
# ENGINE_POOL_SIZE=4
# Hash is MiB per Stockfish process. Size pool/threads to usable CPU cores, not RAM alone.
# ENGINE_HASH_MB=512
# ENGINE_THREADS=1
# Minutes before a mid-flight job's lease is considered dead and requeued.
# Must exceed your worst-case single-game analysis time.
# STALE_LEASE_MINUTES=15
# Set only for your actual proxy. loopback is for nginx/Caddy on the same VPS.
# TRUST_PROXY=loopback
# Set to false to run an HTTP-only instance that does NOT process the queue.
# Use this locally: there is no separate staging database, so a laptop worker
# competes with the deployed one for real users' jobs.
# WORKER_ENABLED=true

# --- Web (apps/web — set as Vercel env vars) ---
NEXT_PUBLIC_API_URL=https://api.getchessplain.com
NEXT_PUBLIC_SUPABASE_URL=https://jgtxprfulkbtzkcvinph.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpndHhwcmZ1bGtidHprY3ZpbnBoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjEyODk0ODIsImV4cCI6MjA3Njg2NTQ4Mn0.E8eXXrpiAiA_T0wz5yh_u6m2USL7QMs7IfSDc80bIKI
NEXT_PUBLIC_POSTHOG_KEY=phc_UKy5oAuRvZ0zofoUDe1hWPGchLU1IkcpjOP2P3aCUa5
